{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-store"}, {"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/event(.*)", "headers": [{"key": "Cache-Control", "value": "private, no-store"}, {"key": "X-Robots-Tag", "value": "noindex, nofollow"}]}
  ]
}
